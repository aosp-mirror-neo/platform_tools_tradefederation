# Ultra-Lightweight Network Heartbeat
# Focuses exclusively on WiFi reliability and signal strength. No system overhead.

write_into_file: true
file_write_period_ms: 5000
max_file_size_bytes: 1000000000

buffers: {
  size_kb: 16384
  fill_policy: RING_BUFFER
}

data_sources: {
  config: {
    name: "linux.ftrace"
    ftrace_config: {
      # Reliability and throughput events
      ftrace_events: "net/netif_receive_skb"
      ftrace_events: "net/net_dev_xmit"
      ftrace_events: "skb/kfree_skb"
      ftrace_events: "tcp/tcp_retransmit_skb"

      # Minimal RSSI hook
      ftrace_events: "cfg80211/cfg80211_cqm_rssi_notify"

      buffer_size_kb: 16384
      drain_period_ms: 250
    }
  }
}

data_sources: {
  config: {
    name: "android.statsd"
    statsd_tracing_config: {
      push_atom_id: ATOM_WIFI_SIGNAL_STRENGTH_CHANGED
    }
  }
}

data_sources: {
  config: {
    name: "linux.process_stats"
    process_stats_config: {
      scan_all_processes_on_start: true
    }
  }
}

data_sources: {
  config: {
    name: "android.network_packets"
    network_packet_trace_config: {
      poll_ms: 500
      intern_limit: 1000
    }
  }
}

data_sources: {
  config: {
    name: "android.packages_list"
    packages_list_config: {
    }
  }
}
