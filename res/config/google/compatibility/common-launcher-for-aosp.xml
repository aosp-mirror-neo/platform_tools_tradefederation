<configuration description="Runs a compatibility test suite on AOSP branches in the lab">
    <!-- logcat will be logged in subprocess instead of parent process -->
    <option name="skip-parent-process-logcat" value="true" />
    <!-- Gce enabled this configuration -->
    <include name="google/template/virtual/default_acloud" />
    <template-include name="log-saver" default="google/template/reporters/android-build-api-log-saver" />
    <option name="invocation-data" key="use_artifact_v3_api" value="true" />
    <template-include name="preparers" default="google/compatibility/default-cts-build-provider-and-preparers" />

    <!-- place holder for additional preparers -->
    <template-include name="extra-preparers" default="empty" />

    <template-include name="metrics_collectors" default="empty" />

    <test class="com.google.android.tradefed.testtype.CtsTestLauncher">
        <option name="max-run-time" value="1h30m" />
    </test>
    <result_reporter class="com.google.android.tradefed.result.CoverageMetadataCollector" />
    <result_reporter class="com.google.android.tradefed.result.teststorage.ResultReporter" />
    <result_reporter class="com.android.tradefed.result.resultdb.ResultDBReporter" />

    <template-include name="reporters" default="empty" />

    <logger class="com.android.tradefed.log.FileLogger">
        <option name="max-log-size" value="300" />
    </logger>

</configuration>
